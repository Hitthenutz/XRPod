# Normalize line endings for text files.
* text=auto

# Unity: merge scenes and prefabs as text (Force Text serialization).
unity/**/*.unity    merge=unityyamlmerge eol=lf
unity/**/*.prefab   merge=unityyamlmerge eol=lf
unity/**/*.asset    merge=unityyamlmerge eol=lf
unity/**/*.meta     eol=lf

# Unity binary assets go through Git LFS (run `git lfs install` once).
unity/**/*.fbx      filter=lfs diff=lfs merge=lfs -text
unity/**/*.obj      filter=lfs diff=lfs merge=lfs -text
unity/**/*.blend    filter=lfs diff=lfs merge=lfs -text
unity/**/*.png      filter=lfs diff=lfs merge=lfs -text
unity/**/*.jpg      filter=lfs diff=lfs merge=lfs -text
unity/**/*.jpeg     filter=lfs diff=lfs merge=lfs -text
