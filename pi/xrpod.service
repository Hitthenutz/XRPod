# systemd service: starts the XRPod controller + HUD on boot and restarts it
# if it crashes. Install on the Pi (see README "Run it on the Pi"):
#
#   sudo cp pi/xrpod.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now xrpod
#   journalctl -u xrpod -f          # live logs
#
# Change User and the /home/pi/XRPod paths if your Pi username or clone
# location differ.

[Unit]
Description=XRPod pod controller and HUD
# Mosquitto carries the scent / IAQ node's data; start after it. Wants= (not
# Requires=) so the HUD still runs if the broker is broken.
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
User=pi
WorkingDirectory=/home/pi/XRPod
ExecStart=/usr/bin/python3 /home/pi/XRPod/pi/agent.py
Restart=on-failure
RestartSec=3

# Serve on port 80 so phones can just open http://xrpod.local
Environment=HUD_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Scent / IAQ node over MQTT (see subsystems/iaq/README.md). Without MQTT_HOST the
# scent hub is a stub. /etc/xrpod.env holds MQTT_USER and MQTT_PASS
# (chmod 600, never in git); the leading "-" means it's optional.
Environment=MQTT_HOST=127.0.0.1
EnvironmentFile=-/etc/xrpod.env

[Install]
WantedBy=multi-user.target
