# systemd service: starts the XRPod controller + HUD on boot and restarts it
# if it crashes. Install on the Pi (see README "Run it on the Pi"):
#
#   sudo cp pi/xrpod.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now xrpod
#   journalctl -u xrpod -f          # live logs
#
# Set up for the pod Pi: user "xrpod", repo cloned to /home/xrpod/XRPod.
# Change User and the paths if your Pi username or clone location differ.

[Unit]
Description=XRPod pod controller and HUD
After=network-online.target
Wants=network-online.target

[Service]
User=xrpod
WorkingDirectory=/home/xrpod/XRPod
ExecStart=/usr/bin/python3 /home/xrpod/XRPod/pi/agent.py
Restart=on-failure
RestartSec=3

# Serve on port 80 so phones on the XRPod-Pi hotspot can just open
# http://10.42.0.1 (.local names don't resolve over the hotspot)
Environment=HUD_PORT=80
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Talk to the ESP32 scent node through Mosquitto on this Pi:
Environment=SCENT_HARDWARE=mqtt

# Fans are driven by the ESP32 in esp32/fan-node (same Wi-Fi as the Pi).
# Uncomment once it's running; use its IP if .local names don't resolve:
# Environment=FAN_ESP32_URL=http://xrpod-fan.local

[Install]
WantedBy=multi-user.target